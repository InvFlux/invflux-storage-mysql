<?xml version="1.0"?>
<psalm errorLevel="1" resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config" xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd" findUnusedBaselineEntry="true" findUnusedCode="true" phpVersion="8.1">
    <projectFiles>
        <directory name="src" />
        <directory name="tests" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <ImplicitToStringCast>
            <errorLevel type="suppress">
                <!--
                    attrecord's DbSession contract types query params as `scalar|BinaryParam|null`
                    (BinaryParam is its PostgreSQL bytea/LOB wrapper, and is Stringable). This store is
                    MySQL/MariaDB-only, and attrecord's dialect-gating never wraps binary as a LOB on
                    MySQL — so a BinaryParam is never instantiated at runtime here. The coercion the
                    session bind methods report is a statically-reachable-but-runtime-impossible false
                    positive.
                -->
                <directory name="src/Session" />
                <directory name="tests" />
            </errorLevel>
        </ImplicitToStringCast>
        <PossiblyUnusedProperty>
            <errorLevel type="suppress">
                <!-- Record subclass properties are accessed via attrecord reflection, not direct PHP references -->
                <directory name="src/Worksheet" />
            </errorLevel>
        </PossiblyUnusedProperty>
        <UnusedClass>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
        </UnusedClass>
        <PossiblyUndefinedArrayOffset>
            <errorLevel type="suppress">
                <directory name="tests" />
            </errorLevel>
        </PossiblyUndefinedArrayOffset>
